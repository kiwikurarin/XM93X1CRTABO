# ～ moving out
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/kiwikurarin/XM93X1CRTABO/refs/heads/main/js/lg.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/kiwikurarin/XM93X1CRTABO/refs/heads/main/js/ktm.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
